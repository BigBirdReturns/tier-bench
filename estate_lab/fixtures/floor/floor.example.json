{
  "authority_boundary": {
    "owns": [
      "portable request, event, response, descriptor, conformance, and registry shapes",
      "canonical identities and public test vectors",
      "profile and quality-tier meanings"
    ],
    "refuses": [
      "domain or game law",
      "physical safety authorization",
      "human disposition or outcome acceptance",
      "project priority or scheduling",
      "truth of an observation",
      "supplier fitness outside tested vectors"
    ]
  },
  "bindings": [
    {
      "id": "command-json@1",
      "mechanism": "argv with request and response JSON files; shell execution forbidden",
      "status": "normative-reference"
    },
    {
      "id": "cloudevents-json@1",
      "mechanism": "structured CloudEvents envelope with request_id as id and semantic_id as type",
      "status": "mapping"
    },
    {
      "id": "asyncapi@1",
      "mechanism": "generated event-driven API description for request and response channels",
      "status": "contract-projection"
    },
    {
      "id": "mqtt5@1",
      "mechanism": "request/response topics with correlation data and content type",
      "status": "mapping"
    },
    {
      "id": "websocket-json@1",
      "mechanism": "one JSON envelope per message with explicit request correlation",
      "status": "mapping"
    },
    {
      "id": "osc@1",
      "mechanism": "semantic identifiers map to addresses; authority remains in a companion envelope",
      "status": "mapping"
    },
    {
      "id": "wasm-component@1",
      "mechanism": "WIT world with strict request and response imports/exports",
      "status": "interface-projection"
    },
    {
      "id": "wot-td@1",
      "mechanism": "Thing Description actions/events map to floor envelopes without becoming authority",
      "status": "mapping"
    }
  ],
  "canonicalization": {
    "algorithm": "utf8-sorted-json-sha256-v1",
    "duplicate_keys": "refused",
    "encoding": "UTF-8",
    "hash": "SHA-256",
    "numbers": "finite JSON numbers only",
    "object_keys": "lexicographically sorted",
    "whitespace": "none in identity-bearing bytes"
  },
  "distribution": {
    "artifact_plan": "OCI artifact plus SPDX/CycloneDX and SLSA/Sigstore evidence; publication remains a separate gate",
    "media_types": [
      "application/vnd.axm.interaction-request+json",
      "application/vnd.axm.interaction-response+json",
      "application/vnd.axm.interaction-adapter+json",
      "application/vnd.axm.interaction-conformance+json"
    ]
  },
  "envelopes": {
    "event": "axm-semantic-event/1",
    "request": "axm-interaction-request/1",
    "response": "axm-interaction-response/1",
    "snapshot": "axm-interaction-snapshot/1"
  },
  "extensions": {
    "authority_rule": "extensions may narrow behavior but may not grant authority or change core semantics",
    "namespace_rule": "reverse-domain or registered axm.* prefix"
  },
  "floor_id": "floor1_15cecffbb5464760462b7dbb6ec19fa2",
  "floor_version": "1.0.0",
  "format": "axm-interaction-floor/1",
  "health_states": [
    "ready",
    "degraded",
    "unavailable"
  ],
  "operations": [
    "set",
    "increment",
    "append",
    "remove",
    "toggle"
  ],
  "ordering": {
    "deadline_rule": "expired requests refuse before side effects",
    "duplicate_rule": "same event_id and same bytes must be idempotent; same event_id and different bytes must refuse",
    "event_identity": "content-derived event_id",
    "idempotency_key": "event_id",
    "request_identity": "content-derived request_id",
    "sequence": "monotonic within a declared run when supplied"
  },
  "phases": [
    "source",
    "target"
  ],
  "privacy_classes": [
    "public",
    "internal",
    "confidential",
    "restricted"
  ],
  "profiles": {
    "accessibility@1": {
      "purpose": "Declare modalities and fallbacks so accessibility is part of the adapter contract rather than an afterthought.",
      "requires": [
        "core@1"
      ]
    },
    "agent-delegation@1": {
      "purpose": "Preserve human and agent delegation while prohibiting authority escalation.",
      "requires": [
        "core@1",
        "observability@1"
      ]
    },
    "core@1": {
      "purpose": "Prove envelope identity, bounded authority consumption, semantic non-mutation, and explicit refusal.",
      "requires": []
    },
    "lifecycle@1": {
      "purpose": "Expose health, snapshot, reset, degraded, and unavailable states without inventing completion.",
      "requires": [
        "core@1"
      ]
    },
    "observability@1": {
      "purpose": "Carry W3C Trace Context and structured evidence without promoting telemetry to authority.",
      "requires": [
        "core@1"
      ]
    },
    "privacy@1": {
      "purpose": "Declare data classes and retention behavior without allowing the adapter to silently downgrade them.",
      "requires": [
        "core@1"
      ]
    },
    "replay@1": {
      "purpose": "Prove deterministic replay and event-id idempotency.",
      "requires": [
        "core@1"
      ]
    },
    "supply@1": {
      "purpose": "Bind license and exact implementation bytes while leaving product acceptance external.",
      "requires": [
        "core@1"
      ]
    }
  },
  "quality_tiers": {
    "bronze": {
      "meaning": "portable semantic boundary passes",
      "profiles": [
        "core@1"
      ]
    },
    "declared": {
      "meaning": "descriptor parses; no execution claim",
      "profiles": []
    },
    "gold": {
      "meaning": "operational evidence, supply bytes, and privacy declarations pass",
      "profiles": [
        "core@1",
        "replay@1",
        "lifecycle@1",
        "observability@1",
        "supply@1",
        "privacy@1"
      ]
    },
    "platinum": {
      "meaning": "all profiles plus an independent verifier and a substitution/rip-out receipt",
      "profiles": [
        "core@1",
        "replay@1",
        "lifecycle@1",
        "observability@1",
        "supply@1",
        "privacy@1",
        "accessibility@1",
        "agent-delegation@1"
      ]
    },
    "silver": {
      "meaning": "replay and failure lifecycle pass",
      "profiles": [
        "core@1",
        "replay@1",
        "lifecycle@1"
      ]
    }
  },
  "request_kinds": [
    "describe",
    "health",
    "execute",
    "snapshot",
    "reset"
  ],
