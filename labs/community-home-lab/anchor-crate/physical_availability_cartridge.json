        "max_power_w": 75,
        "memory_mib": 64,
        "network": "none",
        "storage_mib": 16
      },
      "semantic_class": "exact",
      "stop_condition": "Produce one exact physical-availability state or fail.",
      "validators": [
        "validator.availability-state"
      ]
    },
    {
      "backend_preferences": [
        "backend.cuda3090-fixture",
        "backend.riscv-llm-fixture"
      ],
      "cacheable": false,
      "depends_on": [
        "derive_availability"
      ],
      "effects": "none",
      "id": "generate_decision_packet",
