        "structured-json"
      ],
      "resources": {
        "max_power_w": 75,
        "memory_mib": 64,
        "network": "none",
        "storage_mib": 16
      },
      "semantic_class": "exact",
      "stop_condition": "Return the canonical source records or fail.",
      "validators": [
        "validator.normalized-records"
      ]
    },
    {
      "backend_preferences": [
        "backend.host-controller-fixture"
      ],
      "cacheable": true,
      "depends_on": [
