        "candidate-generation",
        "llm-inference",
        "structured-json"
      ],
      "resources": {
        "max_power_w": 300,
        "memory_mib": 2048,
        "network": "none",
        "storage_mib": 512
      },
      "semantic_class": "validator_equivalent",
      "stop_condition": "Return one source-bound candidate decision packet requiring human review.",
      "validators": [
        "validator.decision-packet"
      ]
    },
    {
      "backend_preferences": [
        "backend.host-controller-fixture"
      ],
      "cacheable": true,
      "depends_on": [
        "derive_availability",
        "generate_decision_packet"
      ],
      "effects": "none",
      "id": "verify_decision_packet",
      "input_refs": [
        "node:derive_availability",
        "node:generate_decision_packet"
