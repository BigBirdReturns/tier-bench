        "acceptance-projection",
        "structured-json"
      ],
      "resources": {
        "max_power_w": 75,
        "memory_mib": 64,
        "network": "none",
        "storage_mib": 16
      },
      "semantic_class": "exact",
      "stop_condition": "Controller validators either accept the final product or retain a typed rejection.",
      "validators": [
        "validator.acceptance-product"
      ]
    }
  ],
  "non_goals": [
    "Do not declare the asset ready from administrative quantity alone.",
    "Do not execute maintenance or logistics effects.",
    "Do not expose hidden validators or ask an executor to accept itself."
  ],
  "notes": "This is the first home-lab cartridge because its source truth and acceptance condition are legible without operationally sensitive data.",
  "objective": "Determine whether asset A-17 is physically available, preserve the exact constraint chain, produce a concise candidate packet, and require a named human review before any operational disposition.",
  "required_seams": [
    "seam.capture",
    "seam.custody",
    "seam.degradation",
    "seam.identity",
    "seam.interpretation",
    "seam.outcome",
    "seam.resource-placement",
    "seam.selection",
    "seam.state-compilation",
    "seam.substitution"
