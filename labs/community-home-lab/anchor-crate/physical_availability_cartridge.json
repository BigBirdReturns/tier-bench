  "invariants": [
    "Source records retain stable identity and content custody.",
    "The deterministic availability state is backend independent.",
    "Candidate wording may vary while claim, blockers, evidence, and human-review requirement remain validator equivalent.",
    "Replacing the controller process must not lose accepted node state.",
    "Replacing CUDA with a RISC-V executor creates a new execution treatment without changing portable task identity."
  ],
  "nodes": [
    {
      "backend_preferences": [
        "backend.host-controller-fixture"
      ],
      "cacheable": true,
      "depends_on": [],
