{
  "$id": "urn:task-floor:schema:claim-attestation:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attestation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "claim": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "schema": {
      "const": "task-floor/claim-attestation@1"
    },
    "scope": {
      "type": "object"
    },
    "signatures": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "claim",
    "scope",
    "evidence",
    "attestation_sha256"
  ],
  "title": "Task Floor Claim Attestation",
  "type": "object"
}
