{
  "$id": "tier-bench/astra-stage2-executable-control-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_id": {
      "type": "string"
    },
    "binding_status": {
      "const": "BOUND_EXECUTABLE_IDENTITIES"
    },
    "calibration_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "callable_astra_identity": {
      "const": "UNBOUND"
    },
    "control_count": {
      "const": 3
    },
    "control_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "controls": {
      "items": {
        "$id": "tier-bench/astra-stage2-executable-control-public.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "binding_status": {
            "const": "BOUND_EXECUTABLE_IDENTITY"
          },
          "checkpoint_repository": {
            "minLength": 1,
            "type": "string"
          },
          "checkpoint_revision_sha1": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "class_label": {
            "enum": [
              "recurrent_latent",
              "parallel_latent",
              "conventional_negative"
            ]
          },
          "component_digests": {
            "additionalProperties": false,
            "properties": {
              "adapter_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "hardware_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "model_revision_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "runtime_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "tokenizer_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "weights_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "model_revision_sha256",
              "weights_sha256",
              "tokenizer_sha256",
              "runtime_sha256",
              "adapter_sha256",
              "hardware_sha256"
            ],
            "type": "object"
          },
          "evidence_class": {
            "const": "empirical_local"
          },
          "file_count": {
            "minimum": 1,
            "type": "integer"
          },
          "hardware_topology": {
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "method": {"const": "NVIDIA_SMI_TOPO_MATRIX"},
                  "platform": {"const": "Linux"},
                  "state": {"const": "OBSERVED"}
                }
              },
              {
                "properties": {
                  "inter_device_topology_claimed": {"const": false},
                  "method": {"const": "PLATFORM_LIMITATION_SINGLE_DEVICE"},
                  "platform": {"const": "Windows"},
                  "selected_device_count": {"const": 1},
                  "state": {"const": "NOT_APPLICABLE_SINGLE_SELECTED_DEVICE"}
                }
              }
            ],
            "properties": {
              "implicit_pooling_claimed": {"const": false},
              "inter_device_topology_claimed": {"type": "boolean"},
              "method": {
                "enum": ["NVIDIA_SMI_TOPO_MATRIX", "PLATFORM_LIMITATION_SINGLE_DEVICE"]
              },
              "platform": {"enum": ["Linux", "Windows"]},
              "schema": {"const": "tier-bench/astra-stage2-topology-evidence@1"},
              "selected_device_count": {"minimum": 1, "type": "integer"},
              "state": {"enum": ["OBSERVED", "NOT_APPLICABLE_SINGLE_SELECTED_DEVICE"]},
              "topology_evidence_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "schema",
              "state",
              "platform",
              "method",
              "selected_device_count",
              "inter_device_topology_claimed",
              "implicit_pooling_claimed",
              "topology_evidence_sha256"
            ],
            "type": "object"
          },
          "local_artifact_set_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "private_locator_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "private_manifest_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "public_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "role": {
            "enum": [
              "lotus_3b_recurrent",
              "loopcoder_v2_7b_parallel",
              "conventional_transformer_negative"
            ]
          },
          "schema": {
            "const": "tier-bench/astra-stage2-executable-control-public@2"
          },
          "source_commit_sha1": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "source_repository": {
            "minLength": 1,
            "type": "string"
          },
          "total_bytes": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "schema",
          "evidence_class",
          "binding_status",
          "role",
          "class_label",
          "source_repository",
          "source_commit_sha1",
          "checkpoint_repository",
          "checkpoint_revision_sha1",
          "component_digests",
          "hardware_topology",
          "local_artifact_set_sha256",
          "private_manifest_sha256",
          "private_locator_sha256",
          "file_count",
          "total_bytes",
          "public_receipt_sha256"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "empirical_observations": {
      "const": 0
    },
    "generator_manifest_sha256": {
      "const": "2050de80cb4688b182cf9e006a97959da422dce24138c6451774f03320517328"
    },
    "law_blob_sha1": {
      "const": "77abe4e177fc61e4f52f56ea64494b113f9662fc"
    },
    "law_commit_sha1": {
      "const": "c36c35bf9b70d879e1e1c9ee2f0296879442df3e"
    },
    "law_tree_sha1": {
      "const": "87bff3320c680e91eaec66c287d7a1ac3b7fe523"
    },
    "live_provider_dispatch": {
      "const": "PROHIBITED"
    },
    "numeric_stage2_freeze": {
      "const": "NOT_ISSUED"
    },
    "observation_count": {
      "const": 648
    },
    "optional_24_call_block": {
      "const": "DISABLED"
    },
    "private_set_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_or_model_calls": {
      "const": 0
    },
    "public_set_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "repository_head_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "repository_tree_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "scaffold_head_sha1": {
      "const": "9babad4631ef517485c56ea4906aab123e30fad7"
    },
    "scaffold_tree_sha1": {
      "const": "720cbf3f26f2e251613acedc52cff08ef33892dc"
    },
    "schema": {
      "const": "tier-bench/astra-stage2-executable-control-set@2"
    },
    "stage1_join_head_sha1": {
      "const": "60bca963d63edca267106bc5c7725c2cc1df8dd7"
    }
  },
  "required": [
    "schema",
    "binding_id",
    "binding_status",
    "repository_head_sha1",
    "repository_tree_sha1",
    "law_commit_sha1",
    "law_tree_sha1",
    "law_blob_sha1",
    "scaffold_head_sha1",
    "scaffold_tree_sha1",
    "stage1_join_head_sha1",
    "generator_manifest_sha256",
    "control_manifest_sha256",
    "calibration_plan_sha256",
    "control_count",
    "observation_count",
    "controls",
    "private_set_receipt_sha256",
    "provider_or_model_calls",
    "empirical_observations",
    "numeric_stage2_freeze",
    "callable_astra_identity",
    "live_provider_dispatch",
    "optional_24_call_block",
    "public_set_receipt_sha256"
  ],
  "type": "object"
}
