{
  "$id": "urn:task-floor:schema:conformance-report:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "bundle_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array"
    },
    "claims": {
      "type": "object"
    },
    "highest_contiguous_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "profiles": {
      "type": "object"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "task-floor/conformance-report@1"
    }
  },
  "required": [
    "schema",
    "kind",
    "profiles",
    "checks",
    "claims",
    "report_sha256"
  ],
  "title": "Task Floor Conformance Report",
  "type": "object"
}
