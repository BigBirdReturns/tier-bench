{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/tier_pilot_production_provider_evidence.schema.json",
  "title": "Activated pilot provider raw-evidence descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "executor_identity", "activation_commit", "activation_sha256", "call_id", "dispatch_receipt_sha256", "provider_result", "raw_artifacts"],
  "properties": {
    "schema": {"const": "tier-bench/tier-pilot-production-provider-evidence@1"},
    "executor_identity": {"const": "tier-bench/pilot-production-adapter@1"},
    "activation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "activation_sha256": {"$ref": "#/$defs/sha256"},
    "call_id": {"type": "string", "minLength": 1},
    "dispatch_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "provider_result": {"$ref": "#/$defs/artifact"},
    "raw_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path", "sha256"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
