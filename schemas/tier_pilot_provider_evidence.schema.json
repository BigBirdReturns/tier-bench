{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/tier_pilot_provider_evidence.schema.json",
  "title": "Pilot provider raw-evidence descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "call_id", "dispatch_receipt_sha256", "provider_result", "raw_artifacts"],
  "properties": {
    "schema": {"const": "tier-bench/tier-pilot-provider-evidence@1"},
    "call_id": {"type": "string", "minLength": 1},
    "dispatch_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "provider_result": {"$ref": "#/$defs/artifact"},
    "raw_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
