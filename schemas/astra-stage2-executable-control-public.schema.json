{
  "$id": "tier-bench/astra-stage2-executable-control-public.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_status": {
      "const": "BOUND_EXECUTABLE_IDENTITY"
    },
    "checkpoint_repository": {
      "minLength": 1,
      "type": "string"
    },
    "checkpoint_revision_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "class_label": {
      "enum": [
        "recurrent_latent",
        "parallel_latent",
        "conventional_negative"
      ]
    },
    "component_digests": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "hardware_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model_revision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "weights_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "model_revision_sha256",
        "weights_sha256",
        "tokenizer_sha256",
        "runtime_sha256",
        "adapter_sha256",
        "hardware_sha256"
      ],
      "type": "object"
    },
    "evidence_class": {
      "const": "empirical_local"
    },
    "file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "local_artifact_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "private_locator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "private_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "role": {
      "enum": [
        "lotus_3b_recurrent",
        "loopcoder_v2_7b_parallel",
        "conventional_transformer_negative"
      ]
    },
    "schema": {
      "const": "tier-bench/astra-stage2-executable-control-public@1"
    },
    "source_commit_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_repository": {
      "minLength": 1,
      "type": "string"
    },
    "total_bytes": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "evidence_class",
    "binding_status",
    "role",
    "class_label",
    "source_repository",
    "source_commit_sha1",
    "checkpoint_repository",
    "checkpoint_revision_sha1",
    "component_digests",
    "local_artifact_set_sha256",
    "private_manifest_sha256",
    "private_locator_sha256",
    "file_count",
    "total_bytes",
    "public_receipt_sha256"
  ],
  "type": "object"
}
