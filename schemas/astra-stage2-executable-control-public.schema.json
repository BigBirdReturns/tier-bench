{
  "$id": "tier-bench/astra-stage2-executable-control-public.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_status": {
      "const": "BOUND_EXECUTABLE_IDENTITY"
    },
    "checkpoint_repository": {
      "minLength": 1,
      "type": "string"
    },
    "checkpoint_revision_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "class_label": {
      "enum": [
        "recurrent_latent",
        "parallel_latent",
        "conventional_negative"
      ]
    },
    "component_digests": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "hardware_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model_revision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "runtime_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "weights_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "model_revision_sha256",
        "weights_sha256",
        "tokenizer_sha256",
        "runtime_sha256",
        "adapter_sha256",
        "hardware_sha256"
      ],
      "type": "object"
    },
    "evidence_class": {
      "const": "empirical_local"
    },
    "file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "hardware_topology": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "method": {"const": "NVIDIA_SMI_TOPO_MATRIX"},
            "platform": {"const": "Linux"},
            "state": {"const": "OBSERVED"}
          }
        },
        {
          "properties": {
            "inter_device_topology_claimed": {"const": false},
            "method": {"const": "PLATFORM_LIMITATION_SINGLE_DEVICE"},
            "platform": {"const": "Windows"},
            "selected_device_count": {"const": 1},
            "state": {"const": "NOT_APPLICABLE_SINGLE_SELECTED_DEVICE"}
          }
        }
      ],
      "properties": {
        "implicit_pooling_claimed": {"const": false},
        "inter_device_topology_claimed": {"type": "boolean"},
        "method": {
          "enum": ["NVIDIA_SMI_TOPO_MATRIX", "PLATFORM_LIMITATION_SINGLE_DEVICE"]
        },
        "platform": {"enum": ["Linux", "Windows"]},
        "schema": {"const": "tier-bench/astra-stage2-topology-evidence@1"},
        "selected_device_count": {"minimum": 1, "type": "integer"},
        "state": {"enum": ["OBSERVED", "NOT_APPLICABLE_SINGLE_SELECTED_DEVICE"]},
        "topology_evidence_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": [
        "schema",
        "state",
        "platform",
        "method",
        "selected_device_count",
        "inter_device_topology_claimed",
        "implicit_pooling_claimed",
        "topology_evidence_sha256"
      ],
      "type": "object"
    },
    "local_artifact_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "private_locator_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "private_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "public_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "role": {
      "enum": [
        "lotus_3b_recurrent",
        "loopcoder_v2_7b_parallel",
        "conventional_transformer_negative"
      ]
    },
    "schema": {
      "const": "tier-bench/astra-stage2-executable-control-public@2"
    },
    "source_commit_sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_repository": {
      "minLength": 1,
      "type": "string"
    },
    "total_bytes": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "evidence_class",
    "binding_status",
    "role",
    "class_label",
    "source_repository",
    "source_commit_sha1",
    "checkpoint_repository",
    "checkpoint_revision_sha1",
    "component_digests",
    "hardware_topology",
    "local_artifact_set_sha256",
    "private_manifest_sha256",
    "private_locator_sha256",
    "file_count",
    "total_bytes",
    "public_receipt_sha256"
  ],
  "type": "object"
}
