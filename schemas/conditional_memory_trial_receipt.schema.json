{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tier-bench.local/schemas/conditional_memory_trial_receipt.schema.json",
  "title": "Tier Bench Conditional Memory Trial Receipt",
  "type": "object",
  "required": [
    "schema",
    "status",
    "lab_id",
    "profile",
    "lab_sha256",
    "plan_sha256",
    "trial_id",
    "arm_id",
    "architecture",
    "seed",
    "seat",
    "attempt",
    "source_hashes",
    "performance",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "tier-bench/conditional-memory-trial-receipt@1"},
    "status": {"enum": ["completed", "failed"]},
    "lab_id": {"type": "string"},
    "profile": {"type": "string"},
    "lab_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_id": {"type": "string"},
    "arm_id": {"type": "string"},
    "architecture": {"type": "string"},
    "seed": {"type": "integer"},
    "seat": {"type": "object"},
    "seat_resolution": {"type": ["object", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "pair_id": {"type": ["string", "null"]},
    "paired_baseline_trial_id": {"type": ["string", "null"]},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "runtime": {"type": ["object", "null"]},
    "data": {"type": ["object", "null"]},
    "model": {"type": ["object", "null"]},
    "training": {"type": ["object", "null"]},
    "evaluation": {"type": ["object", "null"]},
    "golden": {"type": ["object", "null"]},
    "performance": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
