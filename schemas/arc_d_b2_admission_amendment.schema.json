{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tier-bench.local/schemas/arc_d_b2_admission_amendment.schema.json",
  "title": "ARC-D B2 private-custody admission amendment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "charter_id", "state", "parent_authority", "scope", "activation", "versioning", "fresh_attempt", "packet_transport", "custody", "admission_state_machine", "comparison_gate", "implementation_gate", "historical_attempts", "failure_default"],
  "properties": {
    "schema": {"const": "tier-bench/arc-d-harvest-admission-amendment@2"},
    "charter_id": {"const": "arc_d_buffalo_pilot_v2_b2_admission_v2"},
    "state": {"const": "ratification_candidate"},
    "parent_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonical_git_blob_sha256", "adoption_merge", "imported_section_sha256", "substantive_rules_changed", "does_not_reclassify_prior_attempts"],
      "properties": {
        "path": {"const": "data/oss-replay/arc_d_buffalo_pilot_v2/harvest_charter.json"},
        "canonical_git_blob_sha256": {"$ref": "#/$defs/sha256"},
        "adoption_merge": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "imported_section_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sealed_evidence", "grading_instruments", "packet_allowlist", "packet_denylist", "rubric", "prospective_harvest_gate", "disagreement"],
          "properties": {
            "sealed_evidence": {"$ref": "#/$defs/sha256"},
            "grading_instruments": {"$ref": "#/$defs/sha256"},
            "packet_allowlist": {"$ref": "#/$defs/sha256"},
            "packet_denylist": {"$ref": "#/$defs/sha256"},
            "rubric": {"$ref": "#/$defs/sha256"},
            "prospective_harvest_gate": {"$ref": "#/$defs/sha256"},
            "disagreement": {"$ref": "#/$defs/sha256"}
          }
        },
        "substantive_rules_changed": {"const": false},
        "does_not_reclassify_prior_attempts": {"const": true}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changes_only", "unchanged_by_exact_parent_digest", "prospective_procedural_clarification", "clarification_historical_effect", "claim_limit"],
      "properties": {
        "changes_only": {"$ref": "#/$defs/nonempty_strings"},
        "unchanged_by_exact_parent_digest": {"$ref": "#/$defs/nonempty_strings"},
        "prospective_procedural_clarification": {"type": "string", "minLength": 1},
        "clarification_historical_effect": {"type": "string", "minLength": 1},
        "claim_limit": {"const": "publicly commitment-verifiable and independently audited; not publicly reproducible while raw custody bytes remain private"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_only_until", "state_after_adoption", "active_only_when", "state_when_active", "suspension_events", "state_after_suspension"],
      "properties": {
        "proposal_only_until": {"type": "string", "minLength": 1},
        "state_after_adoption": {"const": "ADOPTED_PENDING_CUSTODY"},
        "active_only_when": {"type": "string", "minLength": 1},
        "state_when_active": {"const": "ACTIVE_FOR_FRESH_V2_GRADING"},
        "suspension_events": {"$ref": "#/$defs/nonempty_strings"},
        "state_after_suspension": {"const": "CUSTODY_SUSPENDED"}
      }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adopted_bytes", "downstream_binding", "change_rule"],
      "properties": {
        "adopted_bytes": {"type": "string", "minLength": 1},
        "downstream_binding": {"type": "string", "minLength": 1},
        "change_rule": {"type": "string", "minLength": 1}
      }
    },
    "fresh_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_sessions", "items_per_lane", "lanes", "maximum_dispatches_per_lane_item", "all_sessions_must_start_after_activation", "all_sessions_must_be_fresh_projectless_packet_only", "peer_and_prior_grade_exposure_before_seal", "prior_attempts_may_be_admitted", "rerun_original_subject_responses", "failure_rule"],
      "properties": {
        "required_sessions": {"const": 6},
        "items_per_lane": {"const": 3},
        "lanes": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["grade_a", "grade_b"]}},
        "maximum_dispatches_per_lane_item": {"const": 1},
        "all_sessions_must_start_after_activation": {"const": true},
        "all_sessions_must_be_fresh_projectless_packet_only": {"const": true},
        "peer_and_prior_grade_exposure_before_seal": {"const": false},
        "prior_attempts_may_be_admitted": {"const": false},
        "rerun_original_subject_responses": {"const": false},
        "failure_rule": {"type": "string", "minLength": 1}
      }
    },
    "packet_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grader_visible_packet", "outside_scope_binding", "required_validation", "new_packet_exporter_required"],
      "properties": {
        "grader_visible_packet": {"type": "string", "minLength": 1},
        "outside_scope_binding": {"type": "string", "minLength": 1},
        "required_validation": {"type": "string", "minLength": 1},
        "new_packet_exporter_required": {"const": false}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_bundle_schema", "custody_profile_schema", "attempt_preregistration_schema", "dispatch_ledger_schema", "public_receipt_schema", "batch_receipt_schema", "required_private_artifacts", "requirements", "public_receipts_must_exclude"],
      "properties": {
        "private_bundle_schema": {"const": "schemas/arc_d_b2_private_bundle_manifest.schema.json"},
        "custody_profile_schema": {"const": "schemas/arc_d_b2_custody_profile.schema.json"},
        "attempt_preregistration_schema": {"const": "schemas/arc_d_b2_attempt_preregistration.schema.json"},
        "dispatch_ledger_schema": {"const": "schemas/arc_d_b2_dispatch_ledger.schema.json"},
        "public_receipt_schema": {"const": "schemas/arc_d_b2_public_admission_receipt.schema.json"},
        "batch_receipt_schema": {"const": "schemas/arc_d_b2_batch_admission_receipt.schema.json"},
        "required_private_artifacts": {"$ref": "#/$defs/nonempty_strings"},
        "requirements": {"$ref": "#/$defs/nonempty_strings"},
        "public_receipts_must_exclude": {"$ref": "#/$defs/nonempty_strings"}
      }
    },
    "admission_state_machine": {"$ref": "#/$defs/nonempty_strings"},
    "comparison_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens_only_after", "private_semantic_validation_required", "public_hash_validation_alone_is_insufficient", "decision_rule", "binding_event", "failure_default"],
      "properties": {
        "opens_only_after": {"type": "string", "minLength": 1},
        "private_semantic_validation_required": {"const": true},
        "public_hash_validation_alone_is_insufficient": {"const": true},
        "decision_rule": {"const": "imported unchanged from the parent charter"},
        "binding_event": {"type": "string", "minLength": 1},
        "failure_default": {"type": "string", "minLength": 1}
      }
    },
    "implementation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_at_amendment_merge", "required_later_merged_components", "dispatch_before_all_components_merge"],
      "properties": {
        "state_at_amendment_merge": {"const": "SPECIFICATION_ONLY_NOT_OPERATIONAL"},
        "required_later_merged_components": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
        "dispatch_before_all_components_merge": {"const": "FORBIDDEN"}
      }
    },
    "historical_attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade_a_v1", "grade_b_attempts_1_through_3", "existing_comparator_state", "existing_claim_state"],
      "properties": {
        "grade_a_v1": {"type": "string", "minLength": 1},
        "grade_b_attempts_1_through_3": {"type": "string", "minLength": 1},
        "existing_comparator_state": {"const": "not run"},
        "existing_claim_state": {"type": "string", "minLength": 1}
      }
    },
    "failure_default": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty_strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
