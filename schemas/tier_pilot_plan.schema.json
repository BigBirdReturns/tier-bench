{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/tier_pilot_plan.schema.json",
  "title": "Driver-boundary pilot exact task plan (GATED proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pilot_id",
    "protocol_commit",
    "backend_manifest_sha256",
    "target_remote",
    "default_branch",
    "audit_normalization_profile",
    "real_billed_tolerance_fraction",
    "intervention_log_path",
    "follow_up_days",
    "audit_label_seed_commitment_sha256",
    "residual_order_enumeration",
    "tasks",
    "schedule"
  ],
  "properties": {
    "schema": {"const": "tier-bench/tier-pilot-plan@1"},
    "pilot_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "protocol_commit": {"const": "076fd1e3d97c22f7c33933c5dee4ff897d7ba4e6"},
    "backend_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "target_remote": {"type": "string", "minLength": 1},
    "default_branch": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "audit_normalization_profile": {"$ref": "#/$defs/artifact"},
    "real_billed_tolerance_fraction": {"type": "number", "minimum": 0, "maximum": 0.1},
    "intervention_log_path": {"$ref": "#/$defs/relative_path"},
    "follow_up_days": {"const": 14},
    "audit_label_seed_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "residual_order_enumeration": {
      "const": ["ABC", "ACB", "BAC", "BCA", "CAB", "CBA"]
    },
    "tasks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/task"}
    },
    "schedule": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/schedule_entry"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\)|(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative_path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "base_commit",
        "task",
        "files",
        "acceptance_command",
        "withheld_audit_sha256"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "base_commit": {"$ref": "#/$defs/git_sha"},
        "task": {"type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        },
        "acceptance_command": {"type": "string", "minLength": 1},
        "withheld_audit_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "schedule_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "task_id", "arm", "position", "base_commit"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 30},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "arm": {"enum": ["arm_a", "arm_b", "arm_c"]},
        "position": {"type": "integer", "minimum": 1, "maximum": 3},
        "base_commit": {"$ref": "#/$defs/git_sha"}
      }
    }
  }
}
