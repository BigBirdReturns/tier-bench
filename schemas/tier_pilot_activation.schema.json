{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/tier_pilot_activation.schema.json",
  "title": "Operator-ratified pilot production activation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "protocol_commit", "executor_identity", "composition_manifest", "backend_entry_sha256s", "prompt_templates", "sources", "adapter", "production_schemas", "control_repository", "guards"],
  "properties": {
    "schema": {"const": "tier-bench/tier-pilot-activation@1"},
    "status": {"const": "OPERATOR_RATIFIED"},
    "protocol_commit": {"const": "076fd1e3d97c22f7c33933c5dee4ff897d7ba4e6"},
    "executor_identity": {"const": "tier-bench/pilot-production-adapter@1"},
    "composition_manifest": {"$ref": "#/$defs/artifact"},
    "backend_entry_sha256s": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "prompt_templates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "sources": {"type": "object", "additionalProperties": false, "required": ["activation_validator", "production_adapter", "production_bridge"], "properties": {"activation_validator": {"$ref": "#/$defs/artifact"}, "production_adapter": {"$ref": "#/$defs/artifact"}, "production_bridge": {"$ref": "#/$defs/artifact"}}},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "binary", "cli_version", "help_sha256", "provider_result_schema"], "properties": {"identity": {"const": "tier-bench/pilot-claude-code-bytes@1"}, "version": {"const": "1"}, "binary": {"type": "string", "minLength": 1}, "cli_version": {"type": "string", "minLength": 1}, "help_sha256": {"$ref": "#/$defs/sha256"}, "provider_result_schema": {"const": "tier-bench/tier-backend-result@1"}}},
    "production_schemas": {"type": "object", "additionalProperties": false, "required": ["activation", "dispatch", "provider", "acceptance", "bridge"], "properties": {"activation": {"$ref": "#/$defs/artifact"}, "dispatch": {"$ref": "#/$defs/artifact"}, "provider": {"$ref": "#/$defs/artifact"}, "acceptance": {"$ref": "#/$defs/artifact"}, "bridge": {"$ref": "#/$defs/artifact"}}},
    "control_repository": {"type": "object", "additionalProperties": false, "required": ["remote_url", "default_ref", "evidence_root"], "properties": {"remote_url": {"const": "https://github.com/BigBirdReturns/tier-bench.git"}, "default_ref": {"const": "refs/remotes/origin/main"}, "evidence_root": {"type": "string", "minLength": 1}}},
    "guards": {"type": "object", "additionalProperties": false, "required": ["production_entrypoint_requires_activation", "canary_requires_separate_operator_authorization", "pilot_task_disclosure_authorized", "scientific_verdict_minted"], "properties": {"production_entrypoint_requires_activation": {"const": true}, "canary_requires_separate_operator_authorization": {"const": true}, "pilot_task_disclosure_authorized": {"const": false}, "scientific_verdict_minted": {"const": false}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
