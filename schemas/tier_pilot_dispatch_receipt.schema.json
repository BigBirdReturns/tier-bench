{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/tier_pilot_dispatch_receipt.schema.json",
  "title": "Pilot model-call dispatch receipt (GATED proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "call_id", "task_id", "arm", "stage", "attempt", "backend", "prompt_template", "prompt_sha256", "base_commit", "task_sha256", "files", "acceptance_sha256", "composition_manifest_sha256"],
  "properties": {
    "schema": {"const": "tier-bench/tier-pilot-dispatch-receipt@1"},
    "call_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "arm": {"enum": ["arm_a", "arm_b", "arm_c"]},
    "stage": {"enum": ["driver_plan", "hands", "repair", "escalation", "hands_resume"]},
    "attempt": {"type": "integer", "minimum": 1},
    "backend": {"type": "string", "minLength": 1},
    "prompt_template": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "composition_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
