{
  "$id": "https://bigbirdreturns.github.io/tier-bench/schemas/astra-stage2-scaffold-qualification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {"type": "object"},
    "classification": {"const": "PROVIDER_FREE_SCAFFOLD_QUALIFIED_EMPIRICAL_CALIBRATION_PENDING"},
    "conformance": {"type": "object"},
