# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Harness outputs (per-run scratch — never committed)
*.jsonl
harness_results.jsonl
orchestrator_log.jsonl
llm_costs.jsonl

# ...but curated, contributed data IS the deliverable — keep it tracked.
# (Without these, the blanket *.jsonl above silently drops every
# contribution locally; contributions added via GitHub's web UI dodge it,
# but a local contributor would lose their files with no error.)
!data/results/*.jsonl
!data/control-results/*.jsonl
# Sealed memory shards are the deliverable too — their claim/evidence/ext tables
# are .jsonl and must survive the blanket ignore (Merkle would fail without them).
!memory/samples/**/*.jsonl

# Canonical baselines (generated per-machine)
tasks/_canonical/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Generated cheatsheet (rebuilt by CI)
cheatsheet.html
/index.html
