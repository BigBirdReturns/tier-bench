# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.test-tmp/
.venv/
venv/

# Harness outputs (per-run scratch — never committed)
*.jsonl
harness_results.jsonl
orchestrator_log.jsonl
llm_costs.jsonl

# ...but curated, contributed data IS the deliverable — keep it tracked.
# (Without these, the blanket *.jsonl above silently drops every
# contribution locally; contributions added via GitHub's web UI dodge it,
# but a local contributor would lose their files with no error.)
!data/results/*.jsonl
!data/control-results/*.jsonl
# Raw orchestration event streams are sealed evidence, not disposable telemetry.
!data/orchestration/**/*.jsonl
# OSS replay event snapshots are likewise hash-bound administration evidence.
!data/oss-replay/**/*.jsonl
!data/oss_replay/*.jsonl
# The frontier capture ledger is a deliverable ledger, not run scratch.
!data/capture/*.jsonl
# Sealed memory shards are the deliverable too — their claim/evidence/ext tables
# are .jsonl and must survive the blanket ignore (Merkle would fail without them).
!memory/samples/**/*.jsonl
# The living lens shard's graph/evidence tables are the deliverable too.
!memory/lenses/**/*.jsonl
# Build scratch and the secret publisher key never get committed.
memory/lenses/_build/
memory/lenses/keys/
# Experiment telemetry + structured results are the deliverable — the blanket
# *.jsonl above was silently dropping per-run token/cost data and results.jsonl.
!experiments/**/*.jsonl

# Canonical baselines (generated per-machine)
tasks/_canonical/

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Generated cheatsheet (rebuilt by CI)
cheatsheet.html
/index.html

# Blind-packet/key test fixtures that leak to cwd instead of a tempdir
# (root cause not yet fixed — see spawned cleanup task).
/tmp_*.json
/tmp_*.txt
/tmp_*.md
/tmp_nested/
scripts/tmp_*.json
scripts/tmp_*.txt
scripts/tmp_*.md
scripts/tmp_nested/

# Canary/pilot raw sandbox replicas — the receipts, patches, and call logs
# beside these ARE the deliverable and stay tracked; the full working-tree
# copy used to run/validate a candidate is disposable scratch.
experiments/**/run/**/subject/
experiments/**/run/**/base/
experiments/**/run/**/work/
experiments/**/run/**/accepted/
experiments/**/run/**/empty_git_repo/
experiments/**/run/**/planner_alone_subject/
experiments/**/run/**/planner_to_spark_subject/

# Local-only working area — holds the private blind-grade control key
# (tmp/blind-control-runs/.../control_key.json) that must never be committed.
tmp/

# Per-account Claude Code overrides (holds TIER_BENCH_ACCOUNT — the account tier
# differs per checkout: a Plus wall and a Max20x wall are different meters).
.claude/settings.local.json
# Session-burn hook scratch: per-session byte-offset + running totals (ephemeral,
# per-container). The committed deliverable is burn_log.jsonl, not this state.
experiments/breadth/run/.burn_state/
# Cost-sentinel scratch: per-session byte-offset + accumulated dollars + operator
# ack files (ephemeral, per-container). Enforcement is the hook, not this state.
experiments/breadth/run/.sentinel_state/
