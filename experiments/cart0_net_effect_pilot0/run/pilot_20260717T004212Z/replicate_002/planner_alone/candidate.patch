@@ -1,3 +1,22 @@
 def summarize(events):
     """Return sorted per-service actionable incident totals."""
-    raise NotImplementedError
+    grouped = {}
+    for event in events:
+        service = event["service"]
+        totals = grouped.setdefault(service, {
+            "service": service,
+            "event_count": 0,
+            "actionable_count": 0,
+            "actionable_impact": 0,
+        })
+        totals["event_count"] += 1
+        if not event["suppressed"]:
+            totals["actionable_count"] += 1
+            totals["actionable_impact"] += int(event["impact"])
+
+    return {
+        "services": [grouped[service] for service in sorted(grouped)],
+        "total_actionable_impact": sum(
+            totals["actionable_impact"] for totals in grouped.values()
+        ),
+    }
diff --git a/src/windowing.py b/src/windowing.py
index ce832c4..42d7408 100644
--- a/src/windowing.py
+++ b/src/windowing.py
@@ -1,3 +1,28 @@
 def select_events(events, start, end):
     """Return normalized, deduplicated events in the half-open window."""
-    raise NotImplementedError
+    winners = {}
+
+    for source_index, event in enumerate(events):
+        revision = int(event["revision"])
+        current = winners.get(event["id"])
+        if current is None or revision >= current[0]:
+            winners[event["id"]] = (revision, source_index, event)
+
+    selected = []
+    for revision, source_index, event in winners.values():
+        if event.get("status") == "cancelled":
+            continue
+        timestamp = event["timestamp"]
+        if not (start <= timestamp < end):
+            continue
+        selected.append({
+            "id": event["id"],
+            "service": event["service"],
+            "timestamp": timestamp,
+            "impact": int(event["impact"]),
+            "suppressed": bool(event.get("suppressed", False)),
+            "revision": revision,
+            "source_index": source_index,
+        })
+
+    return sorted(selected, key=lambda event: (event["timestamp"], event["id"]))
