diff --git a/src/summary.py b/src/summary.py
index a191b5f..15214f4 100644
--- a/src/summary.py
+++ b/src/summary.py
@@ -1,3 +1,31 @@
 def summarize(events):
     """Return sorted per-service actionable incident totals."""
-    raise NotImplementedError
+    if not events:
+        return {"services": [], "total_actionable_impact": 0}
+
+    totals = {}
+    total_actionable_impact = 0
+
+    for event in events:
+        service = event["service"]
+        suppressed = bool(event.get("suppressed", False))
+        impact = int(event["impact"])
+
+        stats = totals.get(service)
+        if stats is None:
+            stats = {
+                "service": service,
+                "event_count": 0,
+                "actionable_count": 0,
+                "actionable_impact": 0,
+            }
+            totals[service] = stats
+
+        stats["event_count"] += 1
+        if not suppressed:
+            stats["actionable_count"] += 1
+            stats["actionable_impact"] += impact
+            total_actionable_impact += impact
+
+    services = [totals[service] for service in sorted(totals)]
+    return {"services": services, "total_actionable_impact": total_actionable_impact}
diff --git a/src/windowing.py b/src/windowing.py
index ce832c4..9134c41 100644
--- a/src/windowing.py
+++ b/src/windowing.py
@@ -1,3 +1,38 @@
 def select_events(events, start, end):
     """Return normalized, deduplicated events in the half-open window."""
-    raise NotImplementedError
+    by_id = {}
+    for index, event in enumerate(events):
+        revision = int(event["revision"])
+        event_id = event["id"]
+        record = (revision, index, event)
+
+        previous = by_id.get(event_id)
+        if previous is None:
+            by_id[event_id] = record
+            continue
+
+        previous_revision, previous_index, previous_event = previous
+        if revision > previous_revision or (
+            revision == previous_revision and index > previous_index
+        ):
+            by_id[event_id] = record
+
+    selected = []
+    for event_id, (revision, source_index, event) in by_id.items():
+        if event.get("status") == "cancelled":
+            continue
+
+        normalized = {
+            "id": event_id,
+            "service": event["service"],
+            "timestamp": event["timestamp"],
+            "impact": int(event["impact"]),
+            "suppressed": bool(event.get("suppressed", False)),
+            "revision": revision,
+            "source_index": source_index,
+        }
+        if start <= normalized["timestamp"] < end:
+            selected.append(normalized)
+
+    selected.sort(key=lambda item: (item["timestamp"], item["id"]))
+    return selected
