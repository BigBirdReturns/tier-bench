@@ -1,3 +1,29 @@
 def summarize(events):
     """Return sorted per-service actionable incident totals."""
-    raise NotImplementedError
+    grouped = {}
+    for event in events:
+        service = event["service"]
+        totals = grouped.setdefault(
+            service,
+            {"event_count": 0, "actionable_count": 0, "actionable_impact": 0},
+        )
+        totals["event_count"] += 1
+        if not event.get("suppressed", False):
+            totals["actionable_count"] += 1
+            totals["actionable_impact"] += int(event["impact"])
+
+    services = [
+        {
+            "service": service,
+            "event_count": totals["event_count"],
+            "actionable_count": totals["actionable_count"],
+            "actionable_impact": totals["actionable_impact"],
+        }
+        for service, totals in sorted(grouped.items())
+    ]
+    return {
+        "services": services,
+        "total_actionable_impact": sum(
+            service["actionable_impact"] for service in services
+        ),
+    }
diff --git a/src/windowing.py b/src/windowing.py
index ce832c4..c446791 100644
--- a/src/windowing.py
+++ b/src/windowing.py
@@ -1,3 +1,37 @@
 def select_events(events, start, end):
     """Return normalized, deduplicated events in the half-open window."""
-    raise NotImplementedError
+    winners = {}
+
+    for source_index, event in enumerate(events):
+        event_id = event["id"]
+        revision = int(event["revision"])
+        current = winners.get(event_id)
+        if current is None or (revision, source_index) >= (
+            current["revision"], current["source_index"]
+        ):
+            winners[event_id] = {
+                "event": event,
+                "revision": revision,
+                "source_index": source_index,
+            }
+
+    selected = []
+    for winner in winners.values():
+        event = winner["event"]
+        timestamp = event["timestamp"]
+        if event.get("status") == "cancelled":
+            continue
+        if start <= timestamp < end:
+            selected.append(
+                {
+                    "id": event["id"],
+                    "service": event["service"],
+                    "timestamp": timestamp,
+                    "impact": int(event["impact"]),
+                    "suppressed": event.get("suppressed", False),
+                    "revision": winner["revision"],
+                    "source_index": winner["source_index"],
+                }
+            )
+
+    return sorted(selected, key=lambda event: (event["timestamp"], event["id"]))
