{
  "axes": {
    "accepted_work_economics": "Cost, tokens, GPU time, human time, actions, and energy are normalized per externally accepted task.",
    "approval_portability": "Approval is a portable state-and-action-bound object rather than a UI-local boolean.",
    "artifact_provenance": "Inputs, outputs, traces, handoffs, models, policies, and skills are content-addressed and attestable.",
    "authority_quorum": "Planner, critic, policy, executor, acceptor, credential custodian, and human authority remain separable.",
    "backend_portability": "The task and acceptance contract survive replacement of agent, browser, sandbox, and policy backends.",
    "claim_verification": "Capability and production claims cannot exceed independently verified conformance evidence.",
    "counterfactual_replay": "A trajectory can be replayed or forked from content-addressed checkpoints without silently repeating effects.",
    "credential_custody": "Authenticated state and secrets remain under a declared custodian, delegation scope, and lease.",
    "effect_enforcement": "Effects are declared at action and argument scope, enforced by a trusted host, and retained in receipts.",
    "environment_reproducibility": "Browser, OS, model, policy, dependency, and fixture identities are sufficient to reproduce or explain a run.",
    "external_acceptance": "Completion is decided by an authority independent of the planner and executor.",
    "failure_taxonomy": "Failures are classified across planning, observation, policy, approval, execution, environment, acceptance, and verification.",
    "human_takeover_receipt": "Human intervention is a state-bound lease with pause, release, and re-observation.",
    "idempotency_transactions": "Retries are keyed, duplicate effects are prevented, and transactional boundaries are explicit.",
    "local_distributed_custody": "Remote planners and critics can propose without acquiring executor, browser-profile, or secret authority.",
    "mutation_security": "Conformance includes reordered, delayed, adversarial, prompt-injected, and deceptive variants.",
    "project_handoff": "A successful run emits a typed derivative artifact for the owning project.",
    "retention_privacy": "Data classification, redaction, retention, deletion, and secret exclusion are machine-readable.",
    "rollback_compensation": "Irreversible or partially completed effects declare rollback or compensation behavior.",
    "semantic_visual_route": "Semantic, accessibility, visual, API, workspace, terminal, and human routes remain explicit.",
    "skill_supply_chain": "Learned skills and successful programs have source, review, signatures, compatibility, tests, and rollback.",
    "state_binding": "Actions bind the exact observed state and stale proposals fail before execution.",
    "success_compilation": "Accepted trajectories can compile into reusable deterministic skills or programs with retained provenance.",
    "trajectory_interchange": "A canonical trajectory can feed diagnosis, telemetry, replay, evaluation, and benchmark tools.",
    "version_negotiation": "Schemas and interfaces declare versions, compatibility, extensions, and deprecation behavior.",
    "workload_identity": "Runtime actors can prove workload identity and on-behalf-of delegation independently of model text."
  },
  "coverage_states": {
    "documented": "Primary source explicitly describes the axis as a core capability.",
    "not_assessed": "Insufficient primary evidence was reviewed.",
    "not_core": "The axis is outside the documented core scope.",
    "partial": "A useful primitive exists, but the complete Task Floor contract is not documented."
  },
