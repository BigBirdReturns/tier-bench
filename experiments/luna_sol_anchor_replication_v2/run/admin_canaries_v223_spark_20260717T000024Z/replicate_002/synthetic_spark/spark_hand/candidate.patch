 def summarize(records):
     """Return sorted per-account totals for eligible records."""
-    raise NotImplementedError
+    if not records:
+        return []
+
+    totals = {}
+    for record in records:
+        if not record.get("eligible", False):
+            continue
+        account = record["account"]
+        total = int(record["amount"])
+        totals[account] = totals.get(account, 0) + total
+
+    return [
+        {"account": account, "total": total}
+        for account, total in sorted(totals.items(), key=lambda item: item[0])
+    ]
