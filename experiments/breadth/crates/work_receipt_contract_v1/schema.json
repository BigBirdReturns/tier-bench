{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.example/schemas/work_receipt_contract.schema.json",
  "title": "work receipt contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "attempt_id",
    "predecessor_receipts",
    "decision_receipt_sha256",
    "task_envelope_sha256",
    "base_commit",
    "scope",
    "cartridge_manifest_sha256",
    "runtime_evidence",
    "patch_sha256",
    "referee_spec_sha256",
    "referee_result",
    "terminal_state",
    "unlocks",
    "blocks",
    "external_refs",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "work-receipt-contract@1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the task"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this attempt"
    },
    "predecessor_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Array of predecessor receipt SHA256 hashes (may be empty for root receipts)"
    },
    "decision_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA256 of the decision document that authorized this attempt"
    },
    "task_envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA256 of the task envelope defining work scope"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git commit hash (40 hex chars) of repository base state"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "task_type"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["T0", "T1", "T2", "T3", "T4", "T5"],
          "description": "Tier classification of the work"
        },
        "task_type": {
          "type": "string",
          "minLength": 1,
          "description": "Specific task type identifier"
        }
      }
    },
    "cartridge_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA256 of the cartridge manifest used for execution"
    },
    "runtime_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_log", "model_used"],
      "properties": {
        "execution_log": {
          "type": "string",
          "description": "Path or hash of execution log"
        },
        "model_used": {
          "type": "string",
          "minLength": 1,
          "description": "Model identifier used for execution"
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA256 of the generated patch"
    },
    "referee_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA256 of the referee specification used for validation"
    },
    "referee_result": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Verdict from the referee validation"
    },
    "terminal_state": {
      "type": "string",
      "enum": ["ACCEPTED", "REJECTED", "ERROR"],
      "description": "Final state of the attempt"
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of task_ids that this receipt unlocks (may be empty)"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of task_ids that this receipt blocks (may be empty)"
    },
    "external_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bead_id": {
          "type": "string",
          "minLength": 1
        },
        "gas_town_rig": {
          "type": "string",
          "minLength": 1
        },
        "worker_identity": {
          "type": "string",
          "minLength": 1
        },
        "agent_deck_session": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Descriptive external system references (never authoritative over verdict)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of receipt creation"
    }
  }
}
