{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT UI subscription capture packet",
  "type": "object",
  "required": ["capture_id", "model_family", "intelligence", "task_id", "phase", "trial", "raw_output"],
  "properties": {
    "capture_id": {"type": "string"},
    "model_family": {"type": "string"},
    "intelligence": {"type": "string"},
    "selected_model_label": {"type": "string"},
    "task_id": {"type": "string"},
    "phase": {"type": "string"},
    "trial": {"type": "integer", "minimum": 0},
    "visible_thought_seconds": {"type": ["number", "null"]},
    "prompt_text": {"type": "string", "default": ""},
    "raw_output": {"type": "string"},
    "screenshot_sha256": {"type": ["string", "null"]},
    "quota_status": {"type": "string", "default": ""}
  },
  "additionalProperties": true
}
