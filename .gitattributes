# Sealed AXM lens shard: sidecar + Merkle hashes bind the exact sealed bytes.
# autocrlf must never rewrite them at checkout (CLAUDE-LENS-SHARD-WIN).
memory/lenses/shard/** -text -whitespace
memory/lenses/shard.sha256 -text -whitespace

